{
  "name": "unwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "setup:mongodb": "node --import tsx scripts/connect-mongodb.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@mastra/core": "^1.79.0",
    "@sentry/node": "^11.9.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "mongodb": "^7.7.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
