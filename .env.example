# Copy to .env locally. Never paste secrets into chat or VITE_ variables.
# Live calls remain disabled until you enable them after claiming free credits.
ENABLE_LIVE=false
PORT=3001
APP_ORIGIN=http://localhost:5173
SERPAPI_API_KEY=
PAPERINSTRUMENTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MAX_ATTEMPTS=3
ULTRAMARINE_MODEL=ultramarine-1-flash
MONGODB_URI=
MONGODB_DATABASE=unwatch
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
BACKBOARD_API_KEY=
BACKBOARD_MODEL=
BACKBOARD_PROVIDER=openrouter
BACKBOARD_MAX_CALLS=20
SENTRY_DSN=
# Leave auto-top-ups off in every provider dashboard.
SERPAPI_MAX_REQUESTS=200
ULTRAMARINE_BUDGET_USD=4
MAX_COMPARISONS=100
# Local storage only; Render disk is ephemeral. Production live mode requires MongoDB.
DATA_DIR=.data
